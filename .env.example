# ==============================================================================
# StockSense Infrastructure Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stocksense
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/stocksense

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Market Data Service
MARKET_DATA_SERVICE_PORT=8001
EXCHANGE_ID=binance
DATA_STORE_DIR=/app/data_store
ADMIN_API_KEY=dev-admin-secret-key-12345
DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT
DEFAULT_TIMEFRAMES=1h,1d,15m,4h
ENABLE_SCHEDULER=true
LOG_LEVEL=INFO
